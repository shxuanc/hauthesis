{
    "latex-workshop.latex.tools": [
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOC%"
            ]
        },
        {
            "name": "hauthesis-ins",
            "command": "latex",
            "args": [
                "-interaction=nonstopmode",
                "-file-line-error",
                "hauthesis.ins"
            ]
        },
        {
            "name": "hauthesis-dtx",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "hauthesis.dtx"
            ]
        },
        {
            "name": "biber",
            "command": "biber",
            "args": ["%DOCFILE%"]
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": ["%DOCFILE%"]
        },
        {
            "name": "makeindex",
            "command": "makeindex",
            "args": ["-s", "gind.ist", "%DOCFILE%.idx"]
        },
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-xelatex",
                "%DOC%"
            ]
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOC%"
            ]
        },
        {
            "name": "lualatex",
            "command": "lualatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOC%"
            ]
        }
    ],

    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (xelatex)",
            "tools": ["latexmk"]
        },
        {
            "name": "xelatex → biber → xelatex×2",
            "tools": ["xelatex", "biber", "xelatex", "xelatex"]
        },
        {
            "name": "xelatex → bibtex → xelatex×2",
            "tools": ["xelatex", "bibtex", "xelatex", "xelatex"]
        },
        {
            "name": "xelatex",
            "tools": ["xelatex"]
        },
        {
            "name": "xelatex ×2",
            "tools": ["xelatex", "xelatex"]
        },
        {
            "name": "解包 cls + sty",
            "tools": ["hauthesis-ins"]
        },
        {
            "name": "编译 dtx → 生成手册",
            "tools": ["hauthesis-ins", "hauthesis-dtx", "makeindex", "hauthesis-dtx",  "hauthesis-dtx"]
        },
        {
            "name": "pdflatex → bibtex → pdflatex×2",
            "tools": ["pdflatex", "bibtex", "pdflatex", "pdflatex"]
        },
        {
            "name": "lualatex → biber → lualatex×2",
            "tools": ["lualatex", "biber", "lualatex", "lualatex"]
        }
    ],

    "latex-workshop.latex.recipe.default": "latexmk (xelatex)",
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": false,
    "latex-workshop.latex.build.clearLog.everyRecipeStep.enabled": false,
    "latex-workshop.latex.autoClean.run": "never",

    "latex-workshop.latex.rootFile.useSubFile": false,
    "latex-workshop.latex.rootFile.doNotPrompt": true,
    "latex-workshop.latex.search.rootFiles.include": [
        "main.tex",
        "hauthesis.dtx",
        "hauthesis.ins"
    ],

    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
    "latex-workshop.synctex.afterBuild.enabled": true,

    "latex-workshop.showContextMenu": true,
    "latex-workshop.intellisense.package.enabled": true,
    "latex-workshop.message.error.show": false,
    "latex-workshop.message.warning.show": false,
    "latex-workshop.message.log.show": false,
    "latex-workshop.intellisense.citation.label": "title",
    "latex-workshop.intellisense.package.env.enabled": true,
    "makefile.configureOnOpen": false,
}
